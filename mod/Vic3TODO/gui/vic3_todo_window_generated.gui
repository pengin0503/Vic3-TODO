### GENERATED by tools/generate_mod.py from tools/templates/vic3_todo_window.gui.in - do not edit.
### Vic3 TODO: the journal window, its launcher and the shared journal types.
### Additive: two scripted widgets (gui/scripted_widgets/vic3_todo.txt), so no
### vanilla file is replaced.
###
### vic3_todo_launcher  a small button under the sidebar's Map List
### vic3_todo_window    the window, vanilla's default_block_window where the
###                     side panels sit
###
### Client-side state (GetVariableSystem, never saved):
###   com_open_window = vic3_todo_window   the window is open. The key is the
###       Community Mod Framework's, so CMF's own panels close this one.
###   vic3_todo_tab = finished             the Finished tab is shown
###   vic3_todo_kind_picker                the tracker kind list is open
###   vic3_todo_picker_open                the open tracker's target list is open
###   vic3_todo_techcat = military|society the technology picker's tab
###   vic3_todo_confirm_delete             the editor asks to confirm a delete
###   vic3_todo_confirm_clear              the Finished tab asks to confirm
###
### Saved state lives on the player's country and on script containers
### (common/scripted_effects/vic3_todo_effects.txt). Which journal and which
### tracker are open in the editor are container tags (vic3_todo_editing,
### vic3_todo_tr_editing), read here with ScriptContainer.HasTag.
###
### This file is expanded from tools/templates/vic3_todo_window.gui.in by
### tools/generate_mod.py; edit the template, not the output.

@vic3_todo_w = 500
@vic3_todo_text_w = 380

types vic3_todo_window_types
{
	### ----------------------------------------------------------------------
	### Small building blocks
	### ----------------------------------------------------------------------
	type vic3_todo_button = button {
		using = default_button
		size = { 160 26 }
		using = fontsize_small
	}
	type vic3_todo_button_wide = button {
		using = default_button_action
		size = { 240 30 }
	}
	type vic3_todo_label = textbox {
		autoresize = yes
		align = left|nobaseline
		using = fontsize_small
	}
	type vic3_todo_heading = textbox {
		autoresize = yes
		align = left|nobaseline
		using = fontsize_medium
		default_format = "#title"
		margin_top = 4
	}

	### ----------------------------------------------------------------------
	### The window panel
	### ----------------------------------------------------------------------
	type vic3_todo_panel = default_block_window {
		name = "vic3_todo_panel"

		blockoverride "window_header_name" {
			text = "vic3_todo_window_title"
		}
		blockoverride "header_back_button" {
			onclick = "[GetVariableSystem.Clear('com_open_window')]"
			input_action = "back"
		}
		blockoverride "header_close_button" {
			onclick = "[GetVariableSystem.Clear('com_open_window')]"
		}

		blockoverride "fixed_top" {
			flowcontainer = {
				direction = vertical
				spacing = 6
				margin = { 15 6 }
				ignoreinvisible = yes

				### New journal + counts
				flowcontainer = {
					direction = horizontal
					spacing = 12
					vic3_todo_button_wide = {
						text = "vic3_todo_new"
						tooltip = "vic3_todo_new_tt"
						enabled = "[GetScriptedGui('vic3_todo_new_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						onclick = "[GetScriptedGui('vic3_todo_new_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					}
					vic3_todo_label = {
						parentanchor = vcenter
						text = "vic3_todo_counts"
					}
				}

				### Tabs
				flowcontainer = {
					direction = horizontal
					spacing = 6
					vic3_todo_button = {
						text = "vic3_todo_tab_active"
						enabled = "[GetVariableSystem.HasValue('vic3_todo_tab', 'finished')]"
						onclick = "[GetVariableSystem.Clear('vic3_todo_tab')]"
					}
					vic3_todo_button = {
						text = "vic3_todo_tab_finished"
						enabled = "[Not( GetVariableSystem.HasValue('vic3_todo_tab', 'finished') )]"
						onclick = "[GetVariableSystem.Set('vic3_todo_tab', 'finished')]"
					}
				}

				vic3_todo_input_banner = {}
			}
		}

		blockoverride "scrollarea_content" {
			flowcontainer = {
				direction = vertical
				spacing = 8
				margin = { 15 10 }
				ignoreinvisible = yes

				vic3_todo_label = {
					visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('vic3_todo_n_total'), '(CFixedPoint)0' )]"
					text = "vic3_todo_empty"
					multiline = yes
					max_width = @vic3_todo_w
				}

				### Active journals
				flowcontainer = {
					direction = vertical
					spacing = 8
					ignoreinvisible = yes
					visible = "[And( Not( GetVariableSystem.HasValue('vic3_todo_tab', 'finished') ), GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('vic3_todo_n_total'), '(CFixedPoint)0' ) )]"
					datamodel = "[GetPlayer.MakeScope.GetList('vic3_todo_items')]"
					item = {
						vic3_todo_row = {
							datacontext = "[Scope.GetScriptContainer]"
							visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_is_finished'), '(CFixedPoint)0' )]"
						}
					}
				}

				### Finished journals
				flowcontainer = {
					direction = vertical
					spacing = 8
					ignoreinvisible = yes
					visible = "[GetVariableSystem.HasValue('vic3_todo_tab', 'finished')]"

					flowcontainer = {
						direction = horizontal
						spacing = 6
						ignoreinvisible = yes
						vic3_todo_button = {
							visible = "[Not( GetVariableSystem.Exists('vic3_todo_confirm_clear') )]"
							size = { 240 26 }
							text = "vic3_todo_clear_finished"
							enabled = "[GetScriptedGui('vic3_todo_clear_finished_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[GetVariableSystem.Set('vic3_todo_confirm_clear', 'yes')]"
						}
						vic3_todo_label = {
							visible = "[GetVariableSystem.Exists('vic3_todo_confirm_clear')]"
							parentanchor = vcenter
							text = "vic3_todo_clear_confirm"
						}
						vic3_todo_button = {
							visible = "[GetVariableSystem.Exists('vic3_todo_confirm_clear')]"
							size = { 90 26 }
							text = "vic3_todo_yes_delete"
							onclick = "[GetScriptedGui('vic3_todo_clear_finished_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[GetVariableSystem.Clear('vic3_todo_confirm_clear')]"
						}
						vic3_todo_button = {
							visible = "[GetVariableSystem.Exists('vic3_todo_confirm_clear')]"
							size = { 90 26 }
							text = "vic3_todo_no"
							onclick = "[GetVariableSystem.Clear('vic3_todo_confirm_clear')]"
						}
					}

					flowcontainer = {
						direction = vertical
						spacing = 8
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('vic3_todo_n_total'), '(CFixedPoint)0' )]"
						datamodel = "[GetPlayer.MakeScope.GetList('vic3_todo_items')]"
						item = {
							vic3_todo_row = {
								datacontext = "[Scope.GetScriptContainer]"
								visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_is_finished'), '(CFixedPoint)1' )]"
							}
						}
					}
				}
			}
		}
	}

	### ----------------------------------------------------------------------
	### Text input. While an input is open the country owns the placeholder
	### company company_vic3_todo_carrier; the player types into the base
	### game's company-rename popup. As this banner appears it stores the
	### carrier's starting name and opens the popup (the popup cannot open in
	### the click that creates the company). The watcher in the launcher
	### (vic3_todo_input_watcher) sends the new name the moment it differs
	### from the starting one, whether or not this window is still open;
	### "Use this text" does the same by hand.
	### ----------------------------------------------------------------------
	type vic3_todo_input_watcher = widget {
		size = { 1 1 }
		visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('vic3_todo_input_state'), '(CFixedPoint)1' )]"
		widget = {
			size = { 1 1 }
			state = {
				trigger_when = "[And( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('vic3_todo_input_has_old'), '(CFixedPoint)1' ), Not( EqualTo_string( GetPlayer.MakeScope.Var('vic3_todo_in_carrier').GetCompany.GetNameNoFormatting, GetPlayer.MakeScope.Var('vic3_todo_in_old').GetFlagName ) ) )]"
				on_finish = "[GetScriptedGui('vic3_todo_input_commit_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_text', MakeScopeFlag( GetPlayer.MakeScope.Var('vic3_todo_in_carrier').GetCompany.GetNameNoFormatting ) ).End )]"
			}
		}
	}

	type vic3_todo_input_banner = flowcontainer {
		direction = vertical
		spacing = 4
		ignoreinvisible = yes
		visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('vic3_todo_input_state'), '(CFixedPoint)1' )]"

		state = {
			name = _show
			on_start = "[GetScriptedGui('vic3_todo_input_mark_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_text', MakeScopeFlag( GetPlayer.MakeScope.Var('vic3_todo_in_carrier').GetCompany.GetNameNoFormatting ) ).End )]"
			on_start = "[PopupManager.ShowCompanyChangeName( GetPlayer.MakeScope.Var('vic3_todo_in_carrier').GetCompany.Self )]"
		}

		background = {
			using = default_background
			margin = { 6 6 }
		}

		vic3_todo_label = {
			text = "vic3_todo_input_help"
			multiline = yes
			max_width = @vic3_todo_w
		}
		vic3_todo_label = {
			text = "vic3_todo_input_current"
			multiline = yes
			max_width = @vic3_todo_w
		}
		flowcontainer = {
			direction = horizontal
			spacing = 6
			vic3_todo_button = {
				text = "vic3_todo_input_open"
				onclick = "[PopupManager.ShowCompanyChangeName( GetPlayer.MakeScope.Var('vic3_todo_in_carrier').GetCompany.Self )]"
			}
			vic3_todo_button = {
				text = "vic3_todo_input_use"
				tooltip = "vic3_todo_input_use_tt"
				enabled = "[And( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('vic3_todo_input_has_old'), '(CFixedPoint)1' ), Not( EqualTo_string( GetPlayer.MakeScope.Var('vic3_todo_in_carrier').GetCompany.GetNameNoFormatting, GetPlayer.MakeScope.Var('vic3_todo_in_old').GetFlagName ) ) )]"
				onclick = "[GetScriptedGui('vic3_todo_input_commit_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_text', MakeScopeFlag( GetPlayer.MakeScope.Var('vic3_todo_in_carrier').GetCompany.GetNameNoFormatting ) ).End )]"
			}
			vic3_todo_button = {
				text = "vic3_todo_input_cancel"
				onclick = "[GetScriptedGui('vic3_todo_input_cancel_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
	}

	### ----------------------------------------------------------------------
	### The journal's text (datacontext: the journal's ScriptContainer)
	### ----------------------------------------------------------------------
	type vic3_todo_text_lines = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		textbox = {
			text = "vic3_todo_line1"
			autoresize = yes
			multiline = yes
			max_width = @vic3_todo_text_w
			align = left|nobaseline
			using = fontsize_large
			default_format = "#title"
		}
		textbox = {
			visible = "[ScriptContainer.HasVariable('vic3_todo_line2')]"
			text = "vic3_todo_line2"
			autoresize = yes
			multiline = yes
			max_width = @vic3_todo_text_w
			align = left|nobaseline
		}
		textbox = {
			visible = "[ScriptContainer.HasVariable('vic3_todo_line3')]"
			text = "vic3_todo_line3"
			autoresize = yes
			multiline = yes
			max_width = @vic3_todo_text_w
			align = left|nobaseline
		}
		textbox = {
			visible = "[ScriptContainer.HasVariable('vic3_todo_line4')]"
			text = "vic3_todo_line4"
			autoresize = yes
			multiline = yes
			max_width = @vic3_todo_text_w
			align = left|nobaseline
		}
	}

	### Status, deadline and condition count.
	type vic3_todo_status_line = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		vic3_todo_label = {
			text = "vic3_todo_status_line"
		}
		vic3_todo_label = {
			visible = "[And( ScriptContainer.HasTag('vic3_todo_deadline_on'), EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_is_finished'), '(CFixedPoint)0' ) )]"
			text = "vic3_todo_deadline_line"
		}
		vic3_todo_label = {
			visible = "[GreaterThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_all_count'), '(CFixedPoint)0' )]"
			text = "vic3_todo_conditions_line"
		}
	}

	### ----------------------------------------------------------------------
	### One journal in the window's list (datacontext: the journal)
	### ----------------------------------------------------------------------
	type vic3_todo_row = flowcontainer {
		direction = vertical
		spacing = 4
		ignoreinvisible = yes
		minimumsize = { @vic3_todo_w -1 }

		background = {
			using = default_background
			margin = { 6 6 }
		}

		flowcontainer = {
			direction = horizontal
			spacing = 8

			### Complete / reopen
			widget = {
				size = { 30 30 }
				button_icon_check = {
					size = { 100% 100% }
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_is_finished'), '(CFixedPoint)0' )]"
					tooltip = "vic3_todo_complete_tt"
					onclick = "[GetScriptedGui('vic3_todo_item_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
				}
				button_icon_reset = {
					size = { 100% 100% }
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_is_finished'), '(CFixedPoint)1' )]"
					tooltip = "vic3_todo_reopen_tt"
					onclick = "[GetScriptedGui('vic3_todo_item_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
				}
			}

			vic3_todo_text_lines = {}

			flowcontainer = {
				direction = horizontal
				spacing = 4
				vic3_todo_pin_buttons = {}
				button_icon_edit = {
					size = { 26 26 }
					tooltip = "vic3_todo_edit_tt"
					onclick = "[GetScriptedGui('vic3_todo_item_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
					onclick = "[GetVariableSystem.Clear('vic3_todo_confirm_delete')]"
					onclick = "[GetVariableSystem.Clear('vic3_todo_kind_picker')]"
				}
			}
		}

		vic3_todo_status_line = {}

		### Trackers, read-only, while the editor is closed.
		flowcontainer = {
			direction = vertical
			spacing = 4
			ignoreinvisible = yes
			visible = "[And( Not( ScriptContainer.HasTag('vic3_todo_editing') ), GreaterThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_all_count'), '(CFixedPoint)0' ) )]"
			datamodel = "[ScriptContainer.MakeScope.GetList('vic3_todo_trackers')]"
			item = {
				vic3_todo_tracker_view = {
					datacontext = "[Scope.GetScriptContainer]"
				}
			}
		}

		vic3_todo_editor = {
			visible = "[ScriptContainer.HasTag('vic3_todo_editing')]"
		}
	}

	### ----------------------------------------------------------------------
	### The editor (datacontext: the journal; only one is open at a time)
	### ----------------------------------------------------------------------
	type vic3_todo_editor = flowcontainer {
		direction = vertical
		spacing = 4
		ignoreinvisible = yes

		divider_clean = {}

		### Text
		vic3_todo_heading = { text = "vic3_todo_h_text" }
		flowcontainer = {
			direction = horizontal
			spacing = 4
			ignoreinvisible = yes
			vic3_todo_button = {
				size = { 120 26 }
				text = "vic3_todo_rewrite_1"
				enabled = "[GetScriptedGui('vic3_todo_text_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)11' ) ).End )]"
				onclick = "[GetScriptedGui('vic3_todo_text_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)11' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 120 26 }
				visible = "[GreaterThanOrEqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_lines_value'), '(CFixedPoint)2' )]"
				text = "vic3_todo_rewrite_2"
				enabled = "[GetScriptedGui('vic3_todo_text_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)12' ) ).End )]"
				onclick = "[GetScriptedGui('vic3_todo_text_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)12' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 120 26 }
				visible = "[GreaterThanOrEqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_lines_value'), '(CFixedPoint)3' )]"
				text = "vic3_todo_rewrite_3"
				enabled = "[GetScriptedGui('vic3_todo_text_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)13' ) ).End )]"
				onclick = "[GetScriptedGui('vic3_todo_text_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)13' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 120 26 }
				visible = "[GreaterThanOrEqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_lines_value'), '(CFixedPoint)4' )]"
				text = "vic3_todo_rewrite_4"
				enabled = "[GetScriptedGui('vic3_todo_text_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)14' ) ).End )]"
				onclick = "[GetScriptedGui('vic3_todo_text_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)14' ) ).End )]"
			}
		}
		flowcontainer = {
			direction = horizontal
			spacing = 4
			vic3_todo_button = {
				size = { 160 26 }
				text = "vic3_todo_add_line"
				tooltip = "vic3_todo_add_line_tt"
				enabled = "[GetScriptedGui('vic3_todo_text_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)15' ) ).End )]"
				onclick = "[GetScriptedGui('vic3_todo_text_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)15' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 160 26 }
				text = "vic3_todo_remove_line"
				enabled = "[GetScriptedGui('vic3_todo_text_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)21' ) ).End )]"
				onclick = "[GetScriptedGui('vic3_todo_text_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)21' ) ).End )]"
			}
		}

		### Journal features
		vic3_todo_heading = { text = "vic3_todo_h_features" }
		flowcontainer = {
			direction = horizontal
			spacing = 4
			vic3_todo_button = {
				size = { 240 26 }
				text = "vic3_todo_opt_auto"
				tooltip = "vic3_todo_opt_auto_tt"
				onclick = "[GetScriptedGui('vic3_todo_edit_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 240 26 }
				text = "vic3_todo_opt_rule"
				tooltip = "vic3_todo_opt_rule_tt"
				onclick = "[GetScriptedGui('vic3_todo_edit_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
			}
		}
		flowcontainer = {
			direction = horizontal
			spacing = 4
			vic3_todo_button = {
				size = { 240 26 }
				text = "vic3_todo_opt_deadline"
				tooltip = "vic3_todo_opt_deadline_tt"
				onclick = "[GetScriptedGui('vic3_todo_edit_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 240 26 }
				visible = "[ScriptContainer.HasTag('vic3_todo_deadline_on')]"
				text = "vic3_todo_opt_fail"
				tooltip = "vic3_todo_opt_fail_tt"
				onclick = "[GetScriptedGui('vic3_todo_edit_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
			}
		}
		flowcontainer = {
			direction = horizontal
			spacing = 4
			visible = "[ScriptContainer.HasTag('vic3_todo_deadline_on')]"
			vic3_todo_button = {
				size = { 70 26 }
				text = "vic3_todo_dl_minus_year"
				onclick = "[GetScriptedGui('vic3_todo_edit_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)11' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 70 26 }
				text = "vic3_todo_dl_minus_month"
				onclick = "[GetScriptedGui('vic3_todo_edit_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)12' ) ).End )]"
			}
			vic3_todo_label = {
				parentanchor = vcenter
				minimumsize = { 180 -1 }
				align = hcenter|nobaseline
				text = "vic3_todo_deadline_date"
			}
			vic3_todo_button = {
				size = { 70 26 }
				text = "vic3_todo_dl_plus_month"
				onclick = "[GetScriptedGui('vic3_todo_edit_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)13' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 70 26 }
				text = "vic3_todo_dl_plus_year"
				onclick = "[GetScriptedGui('vic3_todo_edit_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)14' ) ).End )]"
			}
		}

		### Conditions
		vic3_todo_heading = { text = "vic3_todo_h_conditions" }
		vic3_todo_label = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_all_count'), '(CFixedPoint)0' )]"
			text = "vic3_todo_no_conditions"
			multiline = yes
			max_width = @vic3_todo_w
		}
		flowcontainer = {
			direction = vertical
			spacing = 6
			ignoreinvisible = yes
			visible = "[GreaterThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_all_count'), '(CFixedPoint)0' )]"
			datamodel = "[ScriptContainer.MakeScope.GetList('vic3_todo_trackers')]"
			item = {
				vic3_todo_tracker_edit = {
					datacontext = "[Scope.GetScriptContainer]"
				}
			}
		}
		vic3_todo_button = {
			size = { 240 26 }
			text = "vic3_todo_add_condition"
			tooltip = "vic3_todo_add_condition_tt"
			enabled = "[LessThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_all_count'), '(CFixedPoint)4' )]"
			onclick = "[GetVariableSystem.Toggle('vic3_todo_kind_picker')]"
		}
		vic3_todo_kind_picker = {
			visible = "[And( GetVariableSystem.Exists('vic3_todo_kind_picker'), LessThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_all_count'), '(CFixedPoint)4' ) )]"
		}

		### Delete
		divider_clean = {}
		flowcontainer = {
			direction = horizontal
			spacing = 6
			ignoreinvisible = yes
			vic3_todo_button = {
				visible = "[Not( GetVariableSystem.Exists('vic3_todo_confirm_delete') )]"
				size = { 200 26 }
				text = "vic3_todo_delete"
				onclick = "[GetVariableSystem.Set('vic3_todo_confirm_delete', 'yes')]"
			}
			vic3_todo_label = {
				visible = "[GetVariableSystem.Exists('vic3_todo_confirm_delete')]"
				parentanchor = vcenter
				text = "vic3_todo_delete_confirm"
			}
			vic3_todo_button = {
				visible = "[GetVariableSystem.Exists('vic3_todo_confirm_delete')]"
				size = { 90 26 }
				text = "vic3_todo_yes_delete"
				onclick = "[GetScriptedGui('vic3_todo_item_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
				onclick = "[GetVariableSystem.Clear('vic3_todo_confirm_delete')]"
			}
			vic3_todo_button = {
				visible = "[GetVariableSystem.Exists('vic3_todo_confirm_delete')]"
				size = { 90 26 }
				text = "vic3_todo_no"
				onclick = "[GetVariableSystem.Clear('vic3_todo_confirm_delete')]"
			}
			vic3_todo_button = {
				size = { 120 26 }
				text = "vic3_todo_close_editor"
				onclick = "[GetScriptedGui('vic3_todo_item_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				onclick = "[GetVariableSystem.Clear('vic3_todo_confirm_delete')]"
			}
		}
	}

	### ----------------------------------------------------------------------
	### A tracker (datacontext: the tracker's ScriptContainer)
	### ----------------------------------------------------------------------
	type vic3_todo_tracker_title = flowcontainer {
		direction = horizontal
		spacing = 6
		ignoreinvisible = yes
		vic3_todo_label = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_is_fail'), '(CFixedPoint)1' )]"
			text = "vic3_todo_tr_fail_prefix"
		}
		vic3_todo_label = {
			text = "vic3_todo_tr_title"
		}
		vic3_todo_label = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)1' )]"
			text = "vic3_todo_tr_target_building"
		}
		vic3_todo_label = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)2' )]"
			text = "vic3_todo_tr_target_technology"
		}
		vic3_todo_label = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)3' )]"
			text = "vic3_todo_tr_target_law"
		}
		vic3_todo_label = {
			visible = "[And( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)4' ), ScriptContainer.HasVariable('vic3_todo_target_cap') )]"
			text = "vic3_todo_tr_target_country"
		}
		vic3_todo_label = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)5' )]"
			text = "vic3_todo_tr_target_rank"
		}
		vic3_todo_label = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)6' )]"
			text = "vic3_todo_tr_target_goods"
		}
		vic3_todo_label = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)7' )]"
			text = "vic3_todo_tr_target_interest_group"
		}
		vic3_todo_label = {
			visible = "[And( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)8' ), ScriptContainer.HasVariable('vic3_todo_target') )]"
			text = "vic3_todo_tr_target_state"
		}
		vic3_todo_label = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_valid'), '(CFixedPoint)0' )]"
			text = "vic3_todo_tr_invalid"
		}
	}

	### Bar and numbers.
	type vic3_todo_tracker_bar = widget {
		size = { 470 22 }
		default_progressbar_horizontal = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_done'), '(CFixedPoint)0' )]"
			blockoverride "values" {
				value = "[FixedPointToFloat( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_ratio') )]"
				min = 0
				max = 1
			}
		}
		green_progressbar_horizontal = {
			size = { 100% 100% }
			visible = "[And( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_done'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_is_fail'), '(CFixedPoint)0' ) )]"
			blockoverride "values" {
				value = "[FixedPointToFloat( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_ratio') )]"
				min = 0
				max = 1
			}
		}
		### A failure condition that is met: red, as vanilla's bad bars.
		bad_progressbar_horizontal = {
			size = { 100% 100% }
			visible = "[And( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_done'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_is_fail'), '(CFixedPoint)1' ) )]"
			blockoverride "values" {
				value = "[FixedPointToFloat( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_ratio') )]"
				min = 0
				max = 1
			}
		}
		textbox = {
			parentanchor = vcenter
			position = { 8 0 }
			autoresize = yes
			align = left|nobaseline
			using = fontsize_small
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_fmt'), '(CFixedPoint)1' )]"
			text = "vic3_todo_tr_nums_int"
		}
		textbox = {
			parentanchor = vcenter
			position = { 8 0 }
			autoresize = yes
			align = left|nobaseline
			using = fontsize_small
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_fmt'), '(CFixedPoint)2' )]"
			text = "vic3_todo_tr_nums_large"
		}
		textbox = {
			parentanchor = vcenter
			position = { 8 0 }
			autoresize = yes
			align = left|nobaseline
			using = fontsize_small
			visible = "[Or( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_fmt'), '(CFixedPoint)3' ), EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_fmt'), '(CFixedPoint)4' ) )]"
			text = "vic3_todo_tr_nums_dec"
		}
		textbox = {
			parentanchor = vcenter
			position = { 8 0 }
			autoresize = yes
			align = left|nobaseline
			using = fontsize_small
			visible = "[And( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_fmt'), '(CFixedPoint)5' ), EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_done'), '(CFixedPoint)1' ) )]"
			text = "vic3_todo_tr_bool_yes"
		}
		textbox = {
			parentanchor = vcenter
			position = { 8 0 }
			autoresize = yes
			align = left|nobaseline
			using = fontsize_small
			visible = "[And( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_fmt'), '(CFixedPoint)5' ), EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_done'), '(CFixedPoint)0' ) )]"
			text = "vic3_todo_tr_bool_no"
		}
		textbox = {
			parentanchor = vcenter
			position = { 8 0 }
			autoresize = yes
			align = left|nobaseline
			using = fontsize_small
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_fmt'), '(CFixedPoint)6' )]"
			text = "vic3_todo_tr_nums_rank"
		}
		textbox = {
			parentanchor = vcenter
			position = { 8 0 }
			autoresize = yes
			align = left|nobaseline
			using = fontsize_small
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_fmt'), '(CFixedPoint)7' )]"
			text = "vic3_todo_tr_nums_days"
		}
		textbox = {
			parentanchor = right|vcenter
			position = { -8 0 }
			autoresize = yes
			align = right|nobaseline
			using = fontsize_small
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_has_steps'), '(CFixedPoint)1' )]"
			text = "vic3_todo_tr_percent"
		}
	}

	### Below the bar: where delta trackers started and where they finish.
	type vic3_todo_tracker_detail = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		vic3_todo_label = {
			visible = "[And( Or( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_mode_value'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_mode_value'), '(CFixedPoint)3' ) ), And( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_has_steps'), '(CFixedPoint)1' ), Not( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_fmt'), '(CFixedPoint)7' ) ) ) )]"
			text = "vic3_todo_tr_detail_delta"
		}
		vic3_todo_label = {
			visible = "[And( Or( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_mode_value'), '(CFixedPoint)2' ), EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_mode_value'), '(CFixedPoint)4' ) ), EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_has_steps'), '(CFixedPoint)1' ) )]"
			text = "vic3_todo_tr_detail_absolute"
		}
	}

	type vic3_todo_tracker_view = flowcontainer {
		direction = vertical
		spacing = 2
		ignoreinvisible = yes
		vic3_todo_tracker_title = {}
		vic3_todo_tracker_bar = {}
	}

	type vic3_todo_tracker_edit = flowcontainer {
		direction = vertical
		spacing = 3
		ignoreinvisible = yes

		flowcontainer = {
			direction = horizontal
			spacing = 6
			vic3_todo_tracker_title = {}
			button_icon_settings = {
				size = { 22 22 }
				tooltip = "vic3_todo_tr_settings_tt"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				onclick = "[GetVariableSystem.Clear('vic3_todo_picker_open')]"
			}
			button_icon_cancel = {
				size = { 22 22 }
				tooltip = "vic3_todo_tr_remove_tt"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
			}
		}
		vic3_todo_tracker_bar = {}
		vic3_todo_tracker_detail = {}

		vic3_todo_tracker_settings = {
			visible = "[ScriptContainer.HasTag('vic3_todo_tr_editing')]"
		}
	}

	type vic3_todo_tracker_settings = flowcontainer {
		direction = vertical
		spacing = 4
		ignoreinvisible = yes
		margin_left = 12

		### Mode (numeric kinds)
		flowcontainer = {
			direction = horizontal
			spacing = 4
			visible = "[And( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_has_steps'), '(CFixedPoint)1' ), Not( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_fmt'), '(CFixedPoint)7' ) ) )]"
			vic3_todo_button = {
				size = { 118 26 }
				text = "vic3_todo_mode_1"
				tooltip = "vic3_todo_mode_1_tt"
				enabled = "[Not( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_mode_value'), '(CFixedPoint)1' ) )]"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)11' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 118 26 }
				text = "vic3_todo_mode_2"
				tooltip = "vic3_todo_mode_2_tt"
				enabled = "[Not( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_mode_value'), '(CFixedPoint)2' ) )]"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)12' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 118 26 }
				text = "vic3_todo_mode_3"
				tooltip = "vic3_todo_mode_3_tt"
				enabled = "[Not( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_mode_value'), '(CFixedPoint)3' ) )]"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)13' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 118 26 }
				text = "vic3_todo_mode_4"
				tooltip = "vic3_todo_mode_4_tt"
				enabled = "[Not( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_mode_value'), '(CFixedPoint)4' ) )]"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)14' ) ).End )]"
			}
		}

		### Goal
		flowcontainer = {
			direction = horizontal
			spacing = 4
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_has_steps'), '(CFixedPoint)1' )]"
			vic3_todo_button = {
				size = { 64 26 }
				text = "vic3_todo_goal_minus_l"
				tooltip = "vic3_todo_goal_step_tt"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)21' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 64 26 }
				text = "vic3_todo_goal_minus_m"
				tooltip = "vic3_todo_goal_step_tt"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)22' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 64 26 }
				text = "vic3_todo_goal_minus_s"
				tooltip = "vic3_todo_goal_step_tt"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)23' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 64 26 }
				text = "vic3_todo_goal_plus_s"
				tooltip = "vic3_todo_goal_step_tt"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)24' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 64 26 }
				text = "vic3_todo_goal_plus_m"
				tooltip = "vic3_todo_goal_step_tt"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)25' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 64 26 }
				text = "vic3_todo_goal_plus_l"
				tooltip = "vic3_todo_goal_step_tt"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)26' ) ).End )]"
			}
		}

		flowcontainer = {
			direction = horizontal
			spacing = 4
			ignoreinvisible = yes
			vic3_todo_button = {
				size = { 200 26 }
				text = "vic3_todo_tr_role"
				tooltip = "vic3_todo_tr_role_tt"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
			}
		}

		flowcontainer = {
			direction = horizontal
			spacing = 4
			ignoreinvisible = yes
			vic3_todo_button = {
				size = { 200 26 }
				visible = "[GreaterThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)0' )]"
				text = "vic3_todo_pick_target"
				onclick = "[GetVariableSystem.Toggle('vic3_todo_picker_open')]"
			}
			vic3_todo_button = {
				size = { 200 26 }
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_has_steps'), '(CFixedPoint)1' )]"
				text = "vic3_todo_recapture"
				tooltip = "vic3_todo_recapture_tt"
				onclick = "[GetScriptedGui('vic3_todo_tracker_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
			}
		}

		### Target lists. Shown while the list is toggled open, or while no
		### target is chosen yet.
		flowcontainer = {
			direction = vertical
			spacing = 4
			ignoreinvisible = yes
			visible = "[And( GreaterThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)0' ), Or( GetVariableSystem.Exists('vic3_todo_picker_open'), Not( ScriptContainer.HasVariable('vic3_todo_has_target') ) ) )]"

			vic3_todo_picker_building = {
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)1' )]"
			}
			flowcontainer = {
				direction = vertical
				spacing = 4
				ignoreinvisible = yes
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)2' )]"
				flowcontainer = {
					direction = horizontal
					spacing = 4
					vic3_todo_button = {
						size = { 100 26 }
						text = "vic3_todo_techcat_production"
						enabled = "[GetVariableSystem.Exists('vic3_todo_techcat')]"
						onclick = "[GetVariableSystem.Clear('vic3_todo_techcat')]"
					}
					vic3_todo_button = {
						size = { 100 26 }
						text = "vic3_todo_techcat_military"
						enabled = "[Not( GetVariableSystem.HasValue('vic3_todo_techcat', 'military') )]"
						onclick = "[GetVariableSystem.Set('vic3_todo_techcat', 'military')]"
					}
					vic3_todo_button = {
						size = { 100 26 }
						text = "vic3_todo_techcat_society"
						enabled = "[Not( GetVariableSystem.HasValue('vic3_todo_techcat', 'society') )]"
						onclick = "[GetVariableSystem.Set('vic3_todo_techcat', 'society')]"
					}
				}
				vic3_todo_picker_technology_production = {
					visible = "[Not( GetVariableSystem.Exists('vic3_todo_techcat') )]"
				}
				vic3_todo_picker_technology_military = {
					visible = "[GetVariableSystem.HasValue('vic3_todo_techcat', 'military')]"
				}
				vic3_todo_picker_technology_society = {
					visible = "[GetVariableSystem.HasValue('vic3_todo_techcat', 'society')]"
				}
			}
			vic3_todo_picker_law = {
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)3' )]"
			}
			flowcontainer = {
				direction = vertical
				spacing = 3
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)4' )]"
				datamodel = "[GetPlayer.MakeScope.GetList('vic3_todo_country_choices')]"
				item = {
					button = {
						using = default_button
						size = { 250 26 }
						using = fontsize_small
						text = "vic3_todo_country_choice"
						onclick = "[GetScriptedGui('vic3_todo_pick_country_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_pick', Scope.GetState.GetCountry.MakeScope ).End )]"
						onclick = "[GetVariableSystem.Clear('vic3_todo_picker_open')]"
					}
				}
			}
			vic3_todo_picker_rank = {
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)5' )]"
			}
			vic3_todo_picker_goods = {
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)6' )]"
			}
			vic3_todo_picker_interest_group = {
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)7' )]"
			}
			### Our states, as vanilla lists them (AccessPlayer.AccessStates).
			flowcontainer = {
				direction = vertical
				spacing = 3
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_target_type'), '(CFixedPoint)8' )]"
				datamodel = "[AccessPlayer.AccessStates]"
				item = {
					button = {
						using = default_button
						size = { 250 26 }
						using = fontsize_small
						text = "vic3_todo_state_choice"
						onclick = "[GetScriptedGui('vic3_todo_pick_state_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_pick', State.MakeScope ).End )]"
						onclick = "[GetVariableSystem.Clear('vic3_todo_picker_open')]"
					}
				}
			}
		}
	}

	### ----------------------------------------------------------------------
	### The body of a journal's own Journal Entry (datacontext: the journal)
	### ----------------------------------------------------------------------
	type vic3_todo_je_body = flowcontainer {
		direction = vertical
		spacing = 4
		ignoreinvisible = yes
		margin = { 10 4 }

		vic3_todo_text_lines = {}
		vic3_todo_status_line = {}
		flowcontainer = {
			direction = vertical
			spacing = 4
			ignoreinvisible = yes
			visible = "[GreaterThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_tr_all_count'), '(CFixedPoint)0' )]"
			datamodel = "[ScriptContainer.MakeScope.GetList('vic3_todo_trackers')]"
			item = {
				vic3_todo_tracker_view = {
					datacontext = "[Scope.GetScriptContainer]"
				}
			}
		}
		flowcontainer = {
			direction = horizontal
			spacing = 6
			ignoreinvisible = yes
			vic3_todo_button = {
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_is_finished'), '(CFixedPoint)0' )]"
				size = { 150 26 }
				text = "vic3_todo_complete"
				onclick = "[GetScriptedGui('vic3_todo_item_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
			}
			vic3_todo_button = {
				size = { 150 26 }
				text = "vic3_todo_open_in_window"
				onclick = "[GetScriptedGui('vic3_todo_item_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'vic3_todo_item', ScriptContainer.MakeScope ).AddScope( 'vic3_todo_op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
				onclick = "[GetVariableSystem.Set('com_open_window', 'vic3_todo_window')]"
			}
		}
	}
}

### ==========================================================================
### THE LAUNCHER: the next slot under the sidebar's Map List (the sidebar sits
### at { 0 200 }, Map List at +580, small slots are 40 high).
### ==========================================================================
widget = {
	name = "vic3_todo_launcher"
	layer = top
	parentanchor = top|left
	position = { 0 825 }
	size = { 42 40 }
	allow_outside = yes
	visible = "[And( GetMetaPlayer.GetPlayedOrObservedCountry.IsValid, Not( GetMetaPlayer.IsObserver ) )]"

	### A vanilla side panel or the ledger opening closes the window.
	widget = {
		state = {
			trigger_when = "[InformationPanelBar.IsAnyPanelOpen]"
			on_finish = "[GetVariableSystem.Clear('com_open_window')]"
		}
	}
	widget = {
		state = {
			trigger_when = "[MapListPanelManager.IsVisible]"
			on_finish = "[GetVariableSystem.Clear('com_open_window')]"
		}
	}

	### The text-input watcher: shown, and so evaluated, only while an
	### input is open.
	vic3_todo_input_watcher = {}

	widget = {
		size = { 100% 100% }
		using = hud_visibility

		widget = {
			size = { 42 40 }
			visible = "[Not( GetVariableSystem.HasValue('com_open_window', 'vic3_todo_window') )]"
			widget = {
				using = clickthrough_blocker
				using = sidebar_button_size_small
				using = selected_sidepanel_animation_small
				blockoverride "selected_visibility" {
					visible = no
				}
				sidepanel_button_small = {
					blockoverride "icon" {
						texture = "gfx/interface/icons/generic_icons/map_list_plus_and_checkmark.dds"
					}
					blockoverride "button_selected" {
						visible = no
					}
					onclick = "[GetVariableSystem.Set('com_open_window', 'vic3_todo_window')]"
					tooltip = "vic3_todo_launcher_tt"
				}
			}
		}
		widget = {
			size = { 42 40 }
			visible = "[GetVariableSystem.HasValue('com_open_window', 'vic3_todo_window')]"
			widget = {
				using = clickthrough_blocker
				using = sidebar_button_size_small
				using = selected_sidepanel_animation_small
				blockoverride "selected_visibility" {
					visible = yes
				}
				sidepanel_button_small = {
					blockoverride "icon" {
						texture = "gfx/interface/icons/generic_icons/map_list_plus_and_checkmark.dds"
					}
					blockoverride "button_selected" {
						visible = yes
					}
					onclick = "[GetVariableSystem.Clear('com_open_window')]"
					tooltip = "vic3_todo_launcher_tt"
				}
			}
		}
		### Count of active journals, as the sidebar's Journal button shows.
		textbox = {
			visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('vic3_todo_n_active'), '(CFixedPoint)0' )]"
			position = { 30 -4 }
			autoresize = yes
			raw_text = "#bold [GetPlayer.MakeScope.ScriptValue('vic3_todo_n_active')|0]#!"
			align = left|nobaseline
			using = fontsize_small
			background = {
				using = default_background
				margin = { 6 3 }
			}
		}
	}
}

### ==========================================================================
### THE WINDOW
### ==========================================================================
widget = {
	name = "vic3_todo_window"
	size = { 100% 100% }
	layer = layer_ingame_menu
	visible = "[And( And( GetMetaPlayer.GetPlayedOrObservedCountry.IsValid, Not( GetMetaPlayer.IsObserver ) ), GetVariableSystem.HasValue('com_open_window', 'vic3_todo_window') )]"

	state = {
		name = _show
		on_start = "[InformationPanelBar.ClosePanel]"
		on_start = "[MapListPanelManager.CloseCurrentPanel]"
		on_start = "[GetScriptedGui('vic3_todo_refresh_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	}

	vbox = {
		parentanchor = top|left
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin_top = 85

		widget = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				vic3_todo_panel = {}
				expand = {}
			}
		}
	}
}
