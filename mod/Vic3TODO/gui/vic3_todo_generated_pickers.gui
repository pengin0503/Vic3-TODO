	### The vanilla outliner pin of the journal's own Journal Entry. Only the
	### child for the journal's slot is visible, so only its datacontext is read.
	type vic3_todo_pin_buttons = widget {
		size = { 26 26 }
		widget = {
			size = { 26 26 }
			visible = "[And( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_je_active'), '(CFixedPoint)1' ), And( ScriptContainer.HasVariable('vic3_todo_slot'), EqualTo_CFixedPoint( ScriptContainer.GetVariableValue('vic3_todo_slot'), '(CFixedPoint)0' ) ) )]"
			button_icon_pin = {
				datacontext = "[GetPlayerJournalEntry('je_vic3_todo_0')]"
				size = { 100% 100% }
				visible = "[JournalEntry.IsPinnedInOutliner]"
				onclick = "[JournalEntry.TogglePinInOutliner]"
				tooltip = "vic3_todo_unpin_tt"
			}
			button_icon_unpin = {
				datacontext = "[GetPlayerJournalEntry('je_vic3_todo_0')]"
				size = { 100% 100% }
				visible = "[Not( JournalEntry.IsPinnedInOutliner )]"
				onclick = "[JournalEntry.TogglePinInOutliner]"
				tooltip = "vic3_todo_pin_tt"
			}
		}
		widget = {
			size = { 26 26 }
			visible = "[And( EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('vic3_todo_je_active'), '(CFixedPoint)1' ), And( ScriptContainer.HasVariable('vic3_todo_slot'), EqualTo_CFixedPoint( ScriptContainer.GetVariableValue('vic3_todo_slot'), '(CFixedPoint)1' ) ) )]"
